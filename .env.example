# =============================================================================
# SAMPRAAN environment template.
#
# Copy to `.env` (local) or paste the values into your platform's environment
# settings (Railway / Render / any container host). NEVER commit real secrets —
# `.env` is gitignored and every value below is a PLACEHOLDER.
#
# Conventions used by this file:
#   [required]      startup FAILS CLOSED in production without it
#   [recommended]   startup succeeds with a loud warning; a capability degrades
#   [optional]      only needed for the named integration
#
# `pnpm run check:env` prints the effective configuration with secrets redacted,
# and `/health` reports which integrations are configured.
# =============================================================================

# ------------------------------------------------------------------ runtime
NODE_ENV=development
# The port the HTTP server binds. Railway/Render inject this automatically;
# production REFUSES to hop to another port if the configured one is busy.
PORT=3000
# [recommended] Public origin of this deployment (used for absolute links and
# for documenting the OAuth redirect). No trailing slash.
APP_URL=http://localhost:3000
# Optional build/release metadata surfaced by /health.
APP_VERSION=1.0.0
APP_COMMIT=

# ------------------------------------------------------------------ database
# [required in production] MySQL 8.x connection string. SAMPRAAN uses the MySQL
# driver; a postgres:// URL is rejected at startup with a clear error.
# Local:   mysql://sampraan:password@localhost:3306/sampraan
# Railway: MySQL plugin → ${{MySQL.MYSQL_URL}}
# Render:  an external MySQL host (RDS/PlanetScale/…) — Render Postgres is NOT
#          compatible with this build.
DATABASE_URL=mysql://sampraan:change-me@localhost:3306/sampraan

# ------------------------------------------------------------------ sessions
# [required in production] Session signing secret, >= 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# [required in production] Binds session tokens to THIS deployment. A token
# signed for another app id is rejected.
VITE_APP_ID=sampraan

# ------------------------------------------------------------------ proxy / CORS
# Set to 1 ONLY when a real reverse proxy fronts the app (Railway/Render do).
# Without it, every client shares one rate-limit bucket.
TRUST_PROXY=1
# Comma-separated browser origins allowed credentialed cross-origin calls.
# UNSET = fail closed (no cross-origin headers emitted). A same-origin UI needs
# nothing here.
# CORS_ORIGIN=https://sampraan.example.gov.in

# ------------------------------------------------------------------ identity provider (optional)
# OAuth2 authorization-code flow. Without it, only seed/admin-provisioned local
# accounts can sign in.
# OAUTH_SERVER_URL=https://idp.example.gov.in
# VITE_OAUTH_PORTAL_URL=https://idp.example.gov.in/portal
# OWNER_OPEN_ID=
# ADMIN_OPEN_ID=

# ------------------------------------------------------------------ blockchain (Hyperledger Besu QBFT)
# The chain is an EXTERNAL deployment dependency: it is NOT started by the app
# image. Point the app at a reachable JSON-RPC endpoint.
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=4224
# [recommended] Operator key that signs backend-submitted transactions. Without
# it the chain adapter runs in MOCK mode (no transaction is ever submitted) —
# never do that in production.
BLOCKCHAIN_PRIVATE_KEY=
# Contract addresses. Normally resolved from blockchain/deployment.json, which
# the deploy script writes; set these only to override a deployment.
# BLOCKCHAIN_IDENTITY_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_ASSET_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_ACCESS_CONTROL_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_GOVERNANCE_CONTRACT_ADDRESS=0x...

# ------------------------------------------------------------------ asset content encryption
# [required in production] 64 hex chars (32 bytes) = AES-256-GCM master key that
# wraps every per-object data key. Treat it as durable secret material: rotating
# it makes existing content unreadable unless the wrapped keys are re-wrapped.
ASSET_CONTENT_MASTER_KEY=
# Storage for encrypted blobs.
#   unset  → local encrypted directory (single instance, needs a persistent volume)
#   set    → content is pushed to IPFS_API_URL (recommended for multi-replica)
ASSET_CONTENT_STORAGE_DIR=
# [REQUIRED IN PRODUCTION] Self-hosted Kubo/IPFS HTTP RPC API — the organization's
# OWN node (e.g. the sampraan-ipfs container). Production REFUSES to start without
# it (no silent local-filesystem fallback). Content is ALWAYS AES-256-GCM encrypted
# BEFORE it is handed to IPFS; the CID of the ciphertext is the stored reference.
# No third-party IPFS provider and no credentials are used — the node is ours.
IPFS_API_URL=http://127.0.0.1:5001/api/v0
# Upload ceiling in bytes (default 20 MiB).
# ASSET_CONTENT_MAX_BYTES=20971520

# ------------------------------------------------------------------ post-quantum crypto assurance (ML-DSA-65)
# Policy decides the algorithm: ECDSA (secp256k1) is the EVM/Besu baseline and
# ML-DSA-65 is ADDED for high-risk/irreversible operations. Users never choose.
#   registered → only holder-registered ML-DSA-65 PUBLIC keys are trusted.
#                PRODUCTION DEFAULT and the only production-safe posture.
#   local-dev  → keys are derived from the operator key, for demos only.
#                REFUSED in production unless PQC_ALLOW_DEV_KEYS_IN_PRODUCTION=1
# PQC_KEY_PROVIDER=registered
# PQC_ALLOW_DEV_KEYS_IN_PRODUCTION=0

# ------------------------------------------------------------------ Graph (read-only query layer, optional)
# The SAMPRAAN subgraph (graph/) is deployed SEPARATELY (graph-node + IPFS +
# Postgres) and is a query convenience only. The application does NOT read this
# variable today: provenance/identity queries decode contract events straight
# from the Besu RPC, so the platform works with no graph-node at all. Set it
# only for tooling that talks to the subgraph endpoint directly.
# GRAPH_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/sampraan/sampraan

# ------------------------------------------------------------------ verification scripts (local tooling)
# Base URL for server/verify-*.mjs
# SAMPRAAN_BASE_URL=http://localhost:3000
# SAMPRAAN_API=http://localhost:3000/api/trpc
# SAMPRAAN_DEMO_MODE=1
