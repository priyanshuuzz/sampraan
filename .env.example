# SAMPRAAN environment configuration template.
# Copy to .env and fill in values. NEVER commit real private keys.

# --- Database (MySQL) ---
# DATABASE_URL=mysql://user:password@localhost:3306/sampraan

# --- Blockchain (Besu QBFT) ---
# RPC endpoint of the local permissioned network
BLOCKCHAIN_RPC_URL=http://localhost:8545
# Fixed chain ID of the SAMPRAAN local QBFT network
BLOCKCHAIN_CHAIN_ID=4224
# Operator key that signs backend-submitted transactions.
# DEMO/LOCAL ONLY value below is the public Besu tutorial genesis key —
# replace with your own operator key for anything beyond local demos.
BLOCKCHAIN_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# Contract addresses: produced by "pnpm run blockchain:deploy" and written to
# blockchain/deployment.json. The backend reads that file automatically; set these
# explicitly only when overriding.
# BLOCKCHAIN_IDENTITY_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_ASSET_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_ACCESS_CONTROL_CONTRACT_ADDRESS=0x...
